# Server-side Gemini credentials only. Never use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional local index override. Defaults to .data/policy-index.json.gz.
YITI_POLICY_INDEX_PATH=

# Vercel build-time private artifact download settings.
YITI_POLICY_ARTIFACT_REPO=myshhaaw/yiti-ai-policy-artifacts
YITI_POLICY_ARTIFACT_TOKEN=
YITI_POLICY_INDEX_SHA256=
